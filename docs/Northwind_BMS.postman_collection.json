{
  "info": {
    "_postman_id": "b1a2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Northwind BMS RESTful API",
    "description": "Set username and password in a Postman environment; login stores the JWT in the token variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8888/projectII/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
  ],
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Environment Credentials)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "    console.log('Saved token to collection variable: token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{username}}\",\n    \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Current Profile (Me)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"current_password\": \"{{currentPassword}}\",\n    \"new_password\": \"{{newPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/password", "host": ["{{baseUrl}}"], "path": ["auth", "password"] }
          }
        }
      ]
    },
    {
      "name": "2. Dashboard",
      "item": [
        {
          "name": "Get Dashboard KPIs",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/dashboard/kpis", "host": ["{{baseUrl}}"], "path": ["dashboard", "kpis"] }
          }
        },
        {
          "name": "Get Dashboard Charts",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/dashboard/charts", "host": ["{{baseUrl}}"], "path": ["dashboard", "charts"] }
          }
        }
      ]
    },
    {
      "name": "3. Products",
      "item": [
        {
          "name": "List Products (Search & Filter)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?page=1&limit=10&search=&category_id=&supplier_id=",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "" },
                { "key": "category_id", "value": "" },
                { "key": "supplier_id", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/products/1", "host": ["{{baseUrl}}"], "path": ["products", "1"] }
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"c_ProductName\": \"ชาเขียวมะลิพรีเมียม\",\n    \"i_SupplierID\": 1,\n    \"i_CategoryID\": 1,\n    \"c_Unit\": \"24 ขวด x 500 ml\",\n    \"i_Price\": 25.00\n}"
            },
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"c_ProductName\": \"ชาเขียวมะลิพรีเมียม (สูตรน้ำผึ้ง)\",\n    \"i_SupplierID\": 1,\n    \"i_CategoryID\": 1,\n    \"c_Unit\": \"24 ขวด x 500 ml\",\n    \"i_Price\": 28.00\n}"
            },
            "url": { "raw": "{{baseUrl}}/products/1", "host": ["{{baseUrl}}"], "path": ["products", "1"] }
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/products/101", "host": ["{{baseUrl}}"], "path": ["products", "101"] }
          }
        }
      ]
    },
    {
      "name": "4. Categories",
      "item": [
        {
          "name": "List Categories",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"] } }
        },
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"c_CategoryName\": \"สมุนไพรและยา\",\n    \"c_Description\": \"ผลิตภัณฑ์บำรุงสุขภาพและสมุนไพร\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"] }
          }
        }
      ]
    },
    {
      "name": "5. Orders",
      "item": [
        {
          "name": "List Orders",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/orders?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["orders"] } }
        },
        {
          "name": "Get Order Details with Items",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/orders/10248", "host": ["{{baseUrl}}"], "path": ["orders", "10248"] } }
        },
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"i_CustomerID\": 1,\n    \"i_EmployeeID\": 1,\n    \"i_ShipperID\": 2,\n    \"c_OrderDate\": \"2026-11-02\",\n    \"items\": [\n        { \"i_ProductID\": 1, \"i_Quantity\": 5 },\n        { \"i_ProductID\": 2, \"i_Quantity\": 10 }\n    ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] }
          }
        }
      ]
    },
    {
      "name": "6. Customers",
      "item": [
        { "name": "List Customers", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/customers?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["customers"] } } }
      ]
    },
    {
      "name": "7. Suppliers",
      "item": [
        { "name": "List Suppliers", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/suppliers", "host": ["{{baseUrl}}"], "path": ["suppliers"] } } }
      ]
    },
    {
      "name": "8. Employees",
      "item": [
        { "name": "List Employees", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/employees", "host": ["{{baseUrl}}"], "path": ["employees"] } } }
      ]
    },
    {
      "name": "9. Shippers",
      "item": [
        { "name": "List Shippers", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/shippers", "host": ["{{baseUrl}}"], "path": ["shippers"] } } }
      ]
    },
    {
      "name": "10. Reports",
      "item": [
        { "name": "Sales Summary", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/reports/sales", "host": ["{{baseUrl}}"], "path": ["reports", "sales"] } } },
        { "name": "Export Products CSV", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/reports/export?type=products", "host": ["{{baseUrl}}"], "path": ["reports", "export"] } } }
      ]
    }
  ]
}
